DATABASE_URL="file:./dev.db"
DEMO_MODE="false"
PLATFORM_FEE_BPS="500"
APP_ORIGIN="http://localhost:3000"
# Existing Hostinger production uses the separate MySQL schema and HTTPS.
# Private storage, mail delivery and real payment safeguards require later acceptance.
# Optional public map style URL. This is configuration, not a secret.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/dark"

# The application opens directly; real ticket sales remain locked disabled.
SITE_MODE="full_platform"
TICKET_SALES_MODE="disabled"
# All requested sales modes remain locked disabled until later launch safeguards are implemented.
# Social URLs are optional; unconfigured or invalid links are hidden.
# SOCIAL_INSTAGRAM_URL=""
# SOCIAL_TIKTOK_URL=""
# Local regression fixtures only. Never set these in a public/production environment.
ISOLATED_TEST_DATA="false"
LOCAL_DEMO_BOOKING_ENABLED="false"

# Phase 2 shared auth limiter. Keep false until the hosting proxy/header trust is verified.
AUTH_TRUST_PROXY="false"
# Recovery uses a private local mailbox only with isolated local SQLite flags.
# No production email provider is configured by this example.

# Optional Google OAuth: supply actual Google Cloud Web application credentials securely.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Production callback: https://mixermates.com/api/auth/google/callback
