const browser=await chromium.launch({channel:'chrome',headless:true}),context=await browser.newContext({viewport:{width:390,height:900}}),page=await context.newPage();page.setDefaultTimeout(15000);await context.route(/^https?:\/\/(?!localhost[:/]|127\.0\.0\.1[:/])/,r=>r.abort());
