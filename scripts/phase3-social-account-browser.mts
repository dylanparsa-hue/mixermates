 await post('test-lab/switch',{role:'Customer'});await page.goto(base+'/friends');await page.getByRole('textbox',{name:'Search people'}).fill('lab_friend');await page.getByRole('button',{name:'Block',exact:true}).click();await expect(page.getByRole('link',{name:'Sam Test',exact:true})).toHaveCount(0);await page.goto(base+'/profile');await page.getByRole('tab',{name:'Privacy',exact:true}).click();await expect(page.getByRole('heading',{name:'Blocked accounts',exact:true})).toBeVisible();await page.getByRole('button',{name:'Unblock',exact:true}).click();await expect(page.getByText('You have no blocked accounts.',{exact:true})).toBeVisible();assert.equal((await get('people')).friends.length,0);checks.push('Block removes discovery and connection; Profile → Privacy unblocks without restoring friendship.');
 await page.getByRole('button',{name:'Edit profile',exact:true}).click();const dialog=page.getByRole('dialog');await dialog.locator('[name=website]').fill('https://example.test');await dialog.locator('[name=instagram]').fill('fictional_mate');await dialog.locator('[name=tiktok]').fill('https://www.tiktok.com/@fictional_mate');await dialog.locator('[name=instagramPublic]').check();await dialog.locator('[name=discoverable]').uncheck();await dialog.getByRole('button',{name:'Save my profile',exact:true}).click();await expect(dialog).toHaveCount(0);await expect(page.getByRole('link',{name:'Website',exact:true})).toHaveAttribute('href','https://example.test/');await expect(page.getByRole('link',{name:'Instagram',exact:true})).toHaveAttribute('href','https://instagram.com/fictional_mate');await expect(page.getByRole('link',{name:'TikTok',exact:true})).toHaveAttribute('href','https://www.tiktok.com/@fictional_mate');
 await post('test-lab/switch',{role:'Community Friend'});assert(!(await get('people')).people.some((p:any)=>p.username==='lab_customer'));await post('test-lab/switch',{role:'Customer'});const me=(await get('me')).user;await post('profile',{...me,name:me.name,city:me.city,bio:me.bio||'',interests:me.interests,website:me.website||'',instagram:me.instagram||'',instagramPublic:me.instagramPublic,attendancePublic:me.attendancePublic,discoverable:true,achievementsPublic:me.achievementsPublic});checks.push('Discovery opt-out excludes public search separately from attendance consent; website, Instagram and TikTok persist safely.');
 await page.goto(base+'/profile');await page.getByRole('button',{name:'Account menu',exact:true}).click();await expect(page.locator('#account-panel')).toBeVisible();await page.keyboard.press('Escape');await expect(page.locator('#account-panel')).toHaveCount(0);await page.getByRole('button',{name:'Notifications',exact:true}).click();await page.mouse.click(6,200);await expect(page.locator('#notification-panel')).toHaveCount(0);await expect(page.getByRole('button',{name:/Message/})).toHaveCount(0);await expect(page.getByText('My space',{exact:true})).toHaveCount(0);await expect(page.locator('.cinema-footer-wordmark')).toHaveCount(0);
 for(const a of await page.locator('.cinema-footer a').all()){const href=await a.getAttribute('href');assert(href?.startsWith('/'));const r=await context.request.get(base+href);assert(r.ok(),href+':'+r.status());}await page.goto(base+'/booking-terms');await expect(page.getByText(/Approved platform Booking Terms have not been supplied/)).toBeVisible();checks.push('Menus dismiss on Escape/outside click; footer links load; missing approved Booking Terms disclosed.');
 const credentialFile=path.join(homedir(),'.mixermates-private/MIXERMATES_OWNER_TEST_ACCESS.txt'),text=await readFile(credentialFile,'utf8');assert.equal((await stat(credentialFile)).mode&0o777,0o600);const matches=[...text.matchAll(/Email: ([^\n]+)[\s\S]*?Temporary password: ([^\n]+)/g)];assert(matches.length>=3);
 for(const m of matches){const c=await browser.newContext();await c.request.get(base+'/api/test-lab/enter');const r=await c.request.post(base+'/api/login',{headers:{Origin:base},data:{email:m[1],password:m[2]}});assert(r.ok(),'Fictional login failed (credentials not logged)');await c.close();}checks.push('All four owner-only fictional email/password accounts successfully sign in; credentials file permissions are 0600.');
