import { chromium, expect } from "@playwright/test";
import { mkdir, writeFile } from "node:fs/promises";
import assert from "node:assert/strict";
import { testLabEnvironment } from "../lib/test-lab-guard";
assert(testLabEnvironment(), "Verified fictional loopback workspace required");
const base = process.env.APP_ORIGIN!;
const out = "/Users/parsa/Desktop/EVENT FINDER/docs/local-code-free-entry";
await mkdir(out, { recursive: true });
const browser = await chromium.launch({ channel: "chrome", headless: true });
const checks: string[] = [], errors: string[] = [];
try {
  for (const width of [390, 1440]) {
    const context = await browser.newContext({ viewport: { width, height: 900 }, reducedMotion: "reduce" });
    await context.route(/^https?:\/\/(?!localhost[:/]|127\.0\.0\.1[:/])/, r => r.abort());
    const p = await context.newPage();
    p.on("pageerror", e => errors.push(e.message));
    await p.goto(base + "/");
    await p.waitForURL(/\/explore$/);
    await expect(p.getByLabel("Workspace", { exact: true })).toBeVisible();
    await expect(p.getByRole("heading", { name: "YOUR NEXT NIGHT STARTS HERE.", exact: true })).toBeVisible();
    await expect(p.getByLabel("Local access code", { exact: true })).toHaveCount(0);
    const me = await (await context.request.get(base + "/api/me")).json();
    assert.equal(me.user.id, "lab-customer");
    assert.equal(me.user.role, "ATTENDEE");
    assert(await p.evaluate(() => document.documentElement.scrollWidth <= innerWidth));
    await p.screenshot({ path: `${out}/home-${width}.png`, fullPage: true });
    checks.push(`Fresh ${width}px browser opens the normal site as the fictional customer without an entry screen`);
    await p.goto(base + "/create");
    await expect(p.locator("#title")).toBeVisible();
    checks.push(`Creator accessible directly at ${width}px`);
    await p.getByLabel("Workspace", { exact: true }).selectOption("Admin");
    await p.waitForURL(/\/admin$/);
    assert.equal((await (await context.request.get(base + "/api/me")).json()).user.role, "ADMIN");
    await p.reload();
    assert.equal((await (await context.request.get(base + "/api/me")).json()).user.role, "ADMIN");
    checks.push(`Role switch and reload preserve the selected fictional actor at ${width}px`);
    await p.goto(base + "/test-lab");
    await expect(p.getByRole("heading", { name: "Developer tools", exact: true })).toBeVisible();
    await context.clearCookies();
    await p.goto(base + "/create?entry=direct");
    await expect(p.locator("#title")).toBeVisible();
    assert(new URL(p.url()).searchParams.get("entry") === "direct");
    checks.push(`Expired/missing session reopens automatically and preserves the requested route at ${width}px`);
    await context.close();
  }
  const c = await browser.newContext();
  assert.equal((await c.request.post(base + "/api/test-lab/workspace", { headers: { Origin: base }, data: { workspace: "Admin" } })).status(), 401);
  assert.equal((await c.request.get(base + "/api/test-lab/enter", { headers: { "sec-fetch-site": "cross-site" }, maxRedirects: 0 })).status(), 403);
  assert.equal((await c.request.post(base + "/api/test-lab/login", { headers: { Origin: "https://example.test" }, data: {} })).status(), 404);
  const opened = await c.request.post(base + "/api/test-lab/login", { headers: { Origin: base }, data: {} });
  assert(opened.ok(), await opened.text());
  const redirected = await c.request.get(base + "/api/test-lab/enter?next=https%3A%2F%2Fexample.test", { maxRedirects: 0 });
  assert.equal(redirected.status(), 303);
  assert.equal(new URL(redirected.headers().location).origin, base);
  checks.push("Code-free local entry works; cross-origin entry, sessionless role selection and external redirect remain rejected");
  await c.close();
  assert.deepEqual(errors, []);
  await writeFile(out + "/results.json", JSON.stringify({ passed: true, checks, pageErrors: errors }, null, 2));
  console.log(JSON.stringify({ passed: true, checks, pageErrors: errors }, null, 2));
} finally { await browser.close(); }
