import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {db} from '../lib/db';
import {reserveBooking,approveRegistration,issueTickets,revokeTicket,updateEventLifecycle} from '../lib/booking-domain';
import {checkIn} from '../lib/services';
import {entranceAction,entranceOverview} from '../lib/entrance';
import {setEventStaff} from '../lib/staff-permissions';
import {writeFile} from 'node:fs/promises';
if(process.env.DB_PASSWORD!==undefined || !/^mysql:\/\/p4test:[^@]+@127\.0\.0\.1:13306\/mixermates_p4_main$/.test(process.env.DATABASE_URL || '') || process.env.ISOLATED_TEST_DATA!=='true')throw Error('Disposable loopback fixture required');
const results:any[]=[];const run=async(name:string,f:()=>Promise<void>)=>{await f();results.push({name,result:'PASS'});};const prefix='p5mysql_'+randomUUID().slice(0,8);const ids:string[]=[];
const user=async(role:string)=>{const id=prefix+ids.length;ids.push(id);return db.user.create({data:{id,email:id+'@example.test',username:id,name:id,passwordHash:'unused',dob:new Date('1990-01-01'),city:'Test',role}});};
const org=await user('ORGANIZER'),staff=await user('STAFF'),guest=await user('ATTENDEE'),admin=await user('ADMIN');
const event=await db.event.create({data:{id:prefix,slug:prefix,title:'Fictional Phase 5 MySQL',description:'Disposable fictional test only',category:'House Party',genre:'House',image:'/images/halloween.jpg',city:'Test',venue:'Test',latitude:0,longitude:0,startsAt:new Date(Date.now()+3600000),endsAt:new Date(Date.now()+86400000),age:18,organizerId:org.id,capacity:20,origin:'REAL',testOnly:true,status:'PUBLISHED',configurationStatus:'TEST_ONLY',approvalRequired:true,tiers:{create:{name:'Test',price:0,quantity:20,maxPerOrder:2}}},include:{tiers:true}});
await setEventStaff(org.id,{eventId:event.id,userId:staff.id,active:true,canCheckIn:true,canViewGuests:true});
const ticket=async()=>{const b=await reserveBooking(guest.id,{eventId:event.id,tierId:event.tiers[0].id,quantity:1,idempotencyKey:randomUUID(),expiresAt:new Date(Date.now()+3600000)});await approveRegistration(org.id,b.id,true);return (await issueTickets(org.id,b.id))[0];};
const a=await ticket();
await run('MySQL 8.0.41 and all six migrations',async()=>{const v:any=await db.$queryRaw`SELECT VERSION() AS version`;assert.match(v[0].version,/^8\.0\.41/);assert.equal((await db.$queryRaw<any[]>`SELECT migration_name FROM _prisma_migrations`).length,6);});
await run('Two scanner QR claims commit once',async()=>{const r=await Promise.allSettled([checkIn(staff.id,event.id,a.token),checkIn(org.id,event.id,a.token)]);assert.equal(r.filter(x=>x.status==='fulfilled').length,1);});
const b=await ticket();await run('QR/manual concurrent confirmation commits once',async()=>{const r=await Promise.allSettled([entranceAction(staff.id,{eventId:event.id,token:b.token,identityConfirmed:true},true),entranceAction(org.id,{eventId:event.id,ticketId:b.id,identityConfirmed:true},true)]);assert.equal(r.filter(x=>x.status==='fulfilled').length,1);});
const c=await ticket();await run('Repeated scanner requests admit only once',async()=>{const r=await Promise.allSettled(Array.from({length:5},()=>checkIn(staff.id,event.id,c.token)));assert.equal(r.filter(x=>x.status==='fulfilled').length,1);});
const d=await ticket();await run('Revocation and admission serialize',async()=>{await Promise.allSettled([revokeTicket(org.id,d.id),checkIn(staff.id,event.id,d.token)]);const t=await db.ticket.findUniqueOrThrow({where:{id:d.id},include:{checkIn:true}});assert(['REVOKED','CHECKED_IN'].includes(t.status));assert.equal(!!t.checkIn,t.status==='CHECKED_IN');});
const e=await ticket();await run('Suspension and admission serialize; subsequent entry denied',async()=>{await Promise.allSettled([updateEventLifecycle(admin.id,event.id,'SUSPENDED'),checkIn(staff.id,event.id,e.token)]);assert.equal((await db.event.findUniqueOrThrow({where:{id:event.id}})).status,'SUSPENDED');await assert.rejects(checkIn(staff.id,event.id,e.token));});
await run('Attendance unique, private and shared counters consistent',async()=>{assert.equal(await db.attendanceRecord.count({where:{userId:guest.id,eventId:event.id,public:false}}),1);const [x,y]=await Promise.all([entranceOverview(org.id,event.id),entranceOverview(staff.id,event.id)]);assert.deepEqual(x.counts,y.counts);assert(x.counts.checkedIn>=3);});
await run('Revoked staff denied immediately',async()=>{await setEventStaff(org.id,{eventId:event.id,userId:staff.id,active:false});await assert.rejects(entranceOverview(staff.id,event.id),/403/);});
await writeFile('/Users/parsa/Desktop/EVENT FINDER/docs/phase5/mysql-results.json',JSON.stringify({version:'8.0.41',isolated:true,results},null,2));console.log(`${results.length} MySQL checks passed`);await db.$disconnect();
