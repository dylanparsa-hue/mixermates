import {chromium,expect} from '@playwright/test';
import {mkdir,writeFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
import path from 'node:path';
import {testLabEnvironment} from '../lib/test-lab-guard';
assert(testLabEnvironment());const base=process.env.APP_ORIGIN!,out=path.resolve('.local/phase3-evidence');await mkdir(out,{recursive:true});
const b=await chromium.launch({channel:'chrome',headless:true}),c=await b.newContext({viewport:{width:1440,height:1000},reducedMotion:'reduce'});await c.route(/^https?:\/\/(?!localhost[:/]|127\.0\.0\.1[:/])/,r=>r.abort());const p=await c.newPage();p.setDefaultTimeout(15000);
try{await p.goto(base+'/');await p.waitForURL(/\/explore/);const setup=await(await c.request.get(base+'/api/setup')).json(),source=setup.events.find((e:any)=>e.title.startsWith('TEST Phase 3 Studio')&&e.creatorState?.payload);const {id,version,creationKey,...draft}=JSON.parse(source.creatorState.payload);draft.title='TEST Neon After Hours';draft.tiers=draft.tiers.map(({id,...t}:any)=>t);draft.fields=draft.fields.map(({id,...f}:any)=>f);draft.creationKey=crypto.randomUUID();const r=await c.request.post(base+'/api/event-workspace',{headers:{Origin:base},data:{draft,advanceTo:3}});assert(r.ok(),await r.text());const data=await r.json();await p.goto(base+'/create?edit='+data.event.id);await expect(p.locator('#title')).toBeVisible();await p.getByRole('button',{name:'Next',exact:true}).click();await p.getByRole('button',{name:'Next',exact:true}).click();for(const theme of ['Dark','Light']){await p.getByRole('radio',{name:theme,exact:true}).first().check();for(const width of [1440,390]){await p.setViewportSize({width,height:1000});await p.getByRole('button',{name:'Edit',exact:true}).click();await p.evaluate(async()=>{await document.fonts.ready;window.scrollTo(0,0);await new Promise<void>(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>r())));});assert(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await p.screenshot({path:`${out}/final-editor-${theme.toLowerCase()}-${width}.png`,animations:'disabled'});await p.getByRole('button',{name:'Preview',exact:true}).click();await p.evaluate(()=>window.scrollTo(0,0));await p.screenshot({path:`${out}/final-preview-${theme.toLowerCase()}-${width}.png`,animations:'disabled'});}}await writeFile(out+'/review-draft.json',JSON.stringify({id:data.event.id,slug:data.event.slug}));console.log('Eight final editor/preview viewport captures saved.');}finally{await b.close();}
