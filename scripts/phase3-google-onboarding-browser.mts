/** UI-only provider simulation: no Google credentials, provider requests or real accounts. */
import {chromium,expect} from '@playwright/test';
import assert from 'node:assert/strict';
import {writeFile,mkdir} from 'node:fs/promises';
import {testLabEnvironment} from '../lib/test-lab-guard';
assert(testLabEnvironment());const base=process.env.APP_ORIGIN!,b=await chromium.launch({channel:'chrome',headless:true}),c=await b.newContext(),p=await c.newPage();p.setDefaultTimeout(15000);await c.route(/^https?:\/\/(?!localhost[:/]|127\.0\.0\.1[:/])/,r=>r.abort());let complete=false,warnings=0;
p.on('dialog',d=>{warnings++;return d.accept();});
await p.goto(base+'/');await p.waitForURL(/\/explore/);const actual=await(await c.request.get(base+'/api/me')).json();
await c.route('**/api/me',r=>r.fulfill({json:complete?actual:{user:null,demo:false,testLab:true}}));
await c.route('**/api/auth/google/status',r=>r.fulfill({json:{configured:true,linked:false,pending:complete?null:{name:'Fictional Google tester',email:'google-onboarding@example.test'}}}));
await c.route('**/api/auth/google/complete',async r=>{const body=r.request().postDataJSON();assert.equal(body.username,'fictional_google');assert(body.dob);complete=true;await r.fulfill({json:{ok:true}});});
try{await p.reload();const dialog=p.getByRole('dialog',{name:'Complete your Google profile',exact:true});await expect(dialog).toBeVisible();await dialog.getByRole('button',{name:'Finish later',exact:true}).click();await expect(dialog).toHaveCount(0);await p.reload();await expect(dialog).toBeVisible();await dialog.getByRole('button',{name:'Close dialog',exact:true}).click();await expect(dialog).toHaveCount(0);assert.equal(warnings,1);await p.reload();await expect(dialog).toBeVisible();await dialog.locator('[name=username]').fill('fictional_google');await dialog.locator('[name=dob]').fill('1995-02-14');await dialog.getByRole('button',{name:'Complete signup',exact:true}).click();await expect(dialog).toHaveCount(0);await expect(p.getByRole('button',{name:'Account menu',exact:true})).toBeVisible();assert.equal(warnings,1,'Completed signup should not show an incomplete-profile unload warning.');await mkdir('.local/phase3-evidence',{recursive:true});const result={provider:'mocked local UI only; no live Google authentication',checks:['Pending profile shown independently of activation','Finish Later closes incomplete setup','Next visit resumes pending setup','Close warns about incomplete setup','Required profile submits and successful completion avoids false unload warning'],warnings};await writeFile('.local/phase3-evidence/google-onboarding-results.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result));}finally{await b.close();}
