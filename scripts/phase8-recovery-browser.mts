 let r=await ctx.request.post(base+'/api/preview/login',{headers:{Origin:base},data:{email:'organizer@vibey.demo',password:'VibeyDemo2026!'}});assert(r.ok());await page.goto(base+'/organizer?tab=Booking%20reviews&event='+eventId);const row=page.locator('.booking-review-entry').filter({hasText:b.id});await row.getByLabel('Review notes').fill('FICTIONAL incoming funds independently reviewed for failure recovery.');await row.getByLabel('Amount independently received (MYR)').fill('35');await row.getByLabel('I independently checked funds',{exact:false}).check();await row.getByRole('button',{name:'Confirm received payment',exact:true}).click();await row.getByText('Payment: confirmed',{exact:false}).waitFor();await row.getByText('0 tickets issued',{exact:false}).waitFor();assert.equal((await db.booking.findUniqueOrThrow({where:{id:b.id}})).paymentState,'CONFIRMED');assert.equal(await db.ticket.count({where:{bookingId:b.id}}),0);
