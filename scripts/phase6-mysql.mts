import {db} from '../lib/db';
import {operationsOverview,requestRefund,reviewRefund,supportRequest,reviewSupport} from '../lib/operations';
import {writeFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
if(process.env.MYSQL_DISPOSABLE_TEST!=='true'||!process.env.DATABASE_URL?.includes('@127.0.0.1:13306/mixermates_p4_main')||process.env.DB_PASSWORD!==undefined)throw Error('Disposable MySQL only');
const results:string[]=[];
const record=(name:string)=>results.push(name);
for(const [id,role] of [['p6_org','ORGANIZER'],['p6_admin','ADMIN'],['p6_guest','ATTENDEE']])await db.user.create({data:{id,role,email:id+'@example.test',username:id,name:id,passwordHash:'unused',dob:new Date('1990-01-01'),city:'Test'}});
const e=await db.event.create({data:{id:'p6_event',slug:'p6-event',title:'Fictional MySQL operations',description:'No real money',category:'House Party',genre:'House',image:'/images/halloween.jpg',city:'Test',venue:'Hidden',latitude:0,longitude:0,startsAt:new Date(Date.now()+86400000),endsAt:new Date(Date.now()+172800000),age:18,organizerId:'p6_org',capacity:10,origin:'REAL',testOnly:true,status:'PUBLISHED',tiers:{create:{name:'General',price:3500,quantity:10,sold:1}},reservedCount:1},include:{tiers:true}});
const b=await db.booking.create({data:{id:'p6_booking',userId:'p6_guest',eventId:e.id,tierId:e.tiers[0].id,quantity:1,total:3500,idempotencyKey:'p6-mysql',lifecycle:'CONFIRMED',registrationState:'APPROVED',paymentState:'CONFIRMED',paymentStatus:'CONFIRMED',inventoryHeld:true,payment:{create:{amount:3500,fee:0,provider:'ORGANIZER_DIRECT',origin:'REAL',workflowState:'CONFIRMED',status:'CONFIRMED',confirmedAt:new Date()}},tickets:{create:{token:crypto.randomUUID(),status:'ACTIVE'}}},include:{payment:true,tickets:true}});
record('Fresh seven MySQL migrations and defaults support fictional records');
const x:any=await operationsOverview('p6_org');assert.equal(x.finance.confirmedDirect,3500);record('Exact scoped direct-payment aggregate');
const rs=await Promise.all([1,2,3].map(()=>requestRefund('p6_guest',{bookingId:b.id,reason:'Fictional MySQL concurrent request'})));assert.equal(new Set(rs.map(r=>r.id)).size,1);let r=rs[0];record('Concurrent refund requests deduplicate on MySQL');
await assert.rejects(()=>reviewRefund('p6_guest',{id:r.id,version:r.version,status:'APPROVED',notes:'Self approval denied'}),/403/);record('Independent reviewer authorization');
r=await reviewRefund('p6_org',{id:r.id,version:r.version,status:'APPROVED',notes:'Fictional policy exception for test'});assert.equal((await db.eventTicketTier.findUniqueOrThrow({where:{id:e.tiers[0].id}})).sold,0);assert.equal((await db.ticket.findUniqueOrThrow({where:{id:b.tickets[0].id}})).status,'REVOKED');record('Atomic cancellation, ticket revocation and stock release');
await assert.rejects(()=>reviewRefund('p6_org',{id:r.id,version:0,status:'REJECTED',notes:'Stale write denied'}),/409/);record('Stale refund transition denied');
r=await reviewRefund('p6_org',{id:r.id,version:r.version,status:'AWAITING_ORGANIZER_TRANSFER',notes:'Fictional pending transfer'});r=await reviewRefund('p6_org',{id:r.id,version:r.version,status:'TRANSFER_REPORTED',notes:'Fictional report no real money',transferReference:'FICTIONAL-MYSQL-EVIDENCE'});assert.equal((await db.payment.findUniqueOrThrow({where:{id:b.payment!.id}})).status,'REFUND_PENDING');record('Transfer evidence does not claim refund confirmation');
r=await reviewRefund('p6_guest',{id:r.id,version:r.version,status:'REFUND_CONFIRMED',received:true,notes:'Fictional customer receipt confirmed'});assert.equal((await db.payment.findUniqueOrThrow({where:{id:b.payment!.id}})).status,'REFUNDED');record('Independent customer receipt confirmation and preserved payment amount');
let s=await supportRequest('p6_guest',{category:'PAYMENT',description:'Fictional private MySQL support case',bookingId:b.id});s=await reviewSupport('p6_admin',{id:s.id,version:s.version,status:'RESOLVED',response:'Fictional case resolution'});assert.equal(s.status,'RESOLVED');record('Support ownership, administrator response and transactional notification');
await writeFile('/Users/parsa/Desktop/EVENT FINDER/docs/phase6/mysql-results.json',JSON.stringify({version:'8.0.41',isolated:true,results},null,2));console.log(results.length+' MySQL checks passed');await db.$disconnect();
