{
  "name": "mixermates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-map-worker.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/sync-map-worker.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests prisma/seed.ts",
    "test:unit": "tsx --test tests/rules.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "build:hostinger": "node scripts/hostinger-build.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@swc/helpers": "0.5.23",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "bcryptjs": "^3.0.2",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.13",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.4.1",
    "next": "16.4.2",
    "prisma": "6.19.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "^4.19.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.3 <25"
  }
}
